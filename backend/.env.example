# Server Port
PORT=5000

# MongoDB Database URI (MongoDB Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pixelperfect?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary Image Storage & CDN Optimization (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
